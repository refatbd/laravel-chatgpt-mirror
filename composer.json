{
  "name": "refatbd/laravel-chatgpt-mirror",
  "description": "High-performance OpenAI-compatible API & ChatGPT Web UI reverse proxy for Laravel with multi-token pooling and concurrency management.",
  "keywords": [
    "refatbd",
    "laravel",
    "chatgpt",
    "openai",
    "reverse-proxy",
    "streaming",
    "concurrency",
    "sse"
  ],
  "homepage": "https://github.com/refatbd/laravel-chatgpt-mirror",
  "license": "MIT",
  "authors": [
    {
      "name": "Mostafizur Rahman Refat",
      "email": "rjrefat@gmail.com",
      "homepage": "https://github.com/refatbd"
    }
  ],
  "require": {
    "php": "^8.2|^8.3|^8.4|^8.5",
    "illuminate/support": "^10.0|^11.0|^12.0",
    "illuminate/http": "^10.0|^11.0|^12.0",
    "illuminate/routing": "^10.0|^11.0|^12.0",
    "illuminate/database": "^10.0|^11.0|^12.0",
    "illuminate/console": "^10.0|^11.0|^12.0",
    "guzzlehttp/guzzle": "^7.8"
  },
  "require-dev": {
    "mockery/mockery": "^1.6",
    "orchestra/testbench": "^8.0|^9.0|^10.0",
    "phpunit/phpunit": "^10.5|^11.0"
  },
  "autoload": {
    "psr-4": {
      "Refatbd\\LaravelChatGptMirror\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Refatbd\\LaravelChatGptMirror\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Refatbd\\LaravelChatGptMirror\\MirrorServiceProvider"
      ],
      "aliases": {
        "Mirror": "Refatbd\\LaravelChatGptMirror\\Facades\\Mirror"
      }
    }
  },
  "scripts": {
    "test": "./vendor/bin/phpunit"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {}
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
